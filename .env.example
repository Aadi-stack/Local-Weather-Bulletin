# ---- Server ----
PORT=3000
NODE_ENV=production

# Comma-separated list of origins allowed to call this API.
# Use "*" only for local development.
ALLOWED_ORIGINS=http://localhost:3000

# ---- Weather provider ----
# open-meteo requires no key (default, good for getting started fast).
# openweather requires OPENWEATHER_API_KEY and is a drop-in alternative
# if you need a commercial SLA. The key NEVER reaches the browser -
# all provider calls happen server-side in src/services/weatherProvider.js.


# ---- Cache ----
# How long (seconds) responses are cached in-memory before re-fetching upstream.
GEOCODE_CACHE_TTL_SECONDS=3600
WEATHER_CACHE_TTL_SECONDS=300

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
